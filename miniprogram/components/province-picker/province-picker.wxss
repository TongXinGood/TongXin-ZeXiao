.pp-any {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 28rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;
  border: 2rpx solid transparent;
}
.pp-any.on {
  background: var(--primary-light);
  color: var(--primary-dark);
  border-color: var(--primary);
  font-weight: 600;
}
.pp-group { margin-top: 16rpx; }
.pp-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.pp-region {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-1);
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary);
  line-height: 1.1;
}
.pp-all {
  margin-left: 16rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
}
.pp-all.on { background: var(--primary); color: #fff; }
.pp-items { display: flex; flex-wrap: wrap; }
.pp-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 60rpx;
  padding: 0 16rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.pp-item.empty { color: #C4CDD6; }
.pp-item.on {
  background: var(--primary-light);
  color: var(--primary-dark);
  border-color: var(--primary);
  font-weight: 600;
}
.pp-count {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: var(--primary);
}
.pp-tip {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
