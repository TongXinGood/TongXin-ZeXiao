.pc {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 28rpx 24rpx;
  transition: transform 0.1s;
}
.pc-hover { transform: scale(0.985); }

.pc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pc-school {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}
.pc-school-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pc-cmp {
  flex-shrink: 0;
  height: 52rpx;
  line-height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--primary);
  color: var(--primary);
  font-size: 24rpx;
  box-sizing: border-box;
}
.pc-cmp.on { background: var(--primary); color: #fff; }
.pc-cmp-hover { opacity: 0.7; }

.pc-major {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
}
.pc-code {
  font-size: 26rpx;
  color: var(--primary);
  margin-right: 12rpx;
}
.pc-major-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.pc-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pc-tags {
  margin-top: 16rpx;
  margin-bottom: -8rpx;
  display: flex;
  flex-wrap: wrap;
}
.pc-tags .tag { margin: 0 12rpx 8rpx 0; }

.pc-stats {
  margin-top: 22rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 16rpx;
}
.pc-stat {
  flex: 1;
  text-align: center;
}
.pc-stat-main { flex: 1.3; }
.pc-divider {
  width: 2rpx;
  height: 56rpx;
  background: var(--line);
}
.pc-val {
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-1);
  line-height: 1.2;
}
.pc-line {
  font-size: 44rpx;
  color: var(--primary);
}
.pc-delta {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.pc-delta.up { color: var(--red); }
.pc-delta.down { color: var(--green); }
.pc-delta.flat { color: var(--text-3); }
.pc-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
