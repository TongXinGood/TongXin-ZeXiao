.page {
  padding-bottom: 160rpx;
}

.hero {
  padding: 36rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #EAF6FF 0%, #F5F9FD 100%);
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.hero-num {
  color: var(--primary);
  font-size: 28rpx;
}

.notice {
  margin: 0 24rpx 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #FFF7E6;
  color: #B76E00;
  font-size: 24rpx;
}

.list-head {
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.list-head-tip { color: var(--text-3); }

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(59, 167, 255, 0.4);
}
.fab-hover { background: var(--primary-dark); }
.fab-badge {
  margin-left: 12rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--primary);
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}
