<view wx:if="{{loading}}" class="state">加载中…</view>
<view wx:elif="{{error}}" class="state">
  <view>{{error}}</view>
  <view class="state-btn" bindtap="retry">重新加载</view>
</view>

<view wx:else class="page">
  <!-- 学校 -->
  <view class="school">
    <view class="school-row">
      <text class="school-name">{{school.name}}</text>
      <text class="tag lv {{school.levelClass}}">{{school.level}}</text>
      <text class="tag school-tag" wx:for="{{school.otherTags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="school-sub">{{school.province}}{{school.city && school.city !== school.province ? ' · ' + school.city : ''}} · {{school.region}}</view>
    <view class="school-link" wx:if="{{school.website}}" bindtap="copyLink" data-url="{{school.website}}">研招网站：{{school.website}}（点击复制）</view>
  </view>

  <!-- 专业切换 -->
  <scroll-view scroll-x class="tabs" enable-flex wx:if="{{tabs.length > 1}}">
    <view wx:for="{{tabs}}" wx:key="id" class="tab {{current.id === item.id ? 'on' : ''}}" bindtap="onTab" data-id="{{item.id}}">
      <view class="tab-label">{{item.label}}</view>
      <view class="tab-sub">{{item.sub}}</view>
    </view>
  </scroll-view>

  <block wx:if="{{current}}">
    <!-- 专业概况 -->
    <view class="card box">
      <view class="major">
        <text class="major-code num">{{current.majorCode}}</text>
        <text class="major-name">{{current.majorName}}</text>
      </view>
      <view class="major-college">{{current.college}}</view>
      <view class="major-tags">
        <text class="tag {{current.degreeClass}}">{{current.degreeLabel}}</text>
        <text class="tag" wx:if="{{current.direction}}">{{current.direction}}</text>
        <text class="tag tag-gray" wx:if="{{current.partTime}}">非全日制</text>
        <text class="tag tag-orange" wx:if="{{current.is408}}">考 408</text>
        <text class="tag" wx:else>自命题</text>
      </view>
      <view class="subjects">
        <view class="subject" wx:for="{{current.subjects}}" wx:key="label">
          <text class="subject-label">{{item.label}}</text>
          <text class="subject-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <!-- 历年复试线 -->
    <view class="card box">
      <view class="box-title">历年复试线<text class="box-tip">总分</text></view>
      <view class="empty-tip" wx:if="{{!current.lines.length}}">暂未收录复试线数据，以院校官网为准</view>
      <view class="chart" wx:if="{{current.lines.length}}">
        <view class="bar-col" wx:for="{{current.bars}}" wx:key="year">
          <view class="bar-delta {{item.deltaClass}}">{{item.deltaText}}</view>
          <view class="bar-value num {{item.empty ? 'muted' : ''}}">{{item.value}}</view>
          <view class="bar-track">
            <view class="bar {{index === current.bars.length - 1 ? 'bar-last' : ''}}" style="height: {{item.height}}%"></view>
          </view>
          <view class="bar-year">{{item.year}}</view>
        </view>
      </view>

      <view class="table" wx:if="{{current.lines.length}}">
        <view class="tr th">
          <view class="td td-year">年份</view>
          <view class="td">总分</view>
          <view class="td">政治</view>
          <view class="td">外语</view>
          <view class="td">数学</view>
          <view class="td">专业课</view>
        </view>
        <view class="tr" wx:for="{{current.lines}}" wx:key="year">
          <view class="td td-year">{{item.year}}</view>
          <view class="td num td-strong">{{item.total}}</view>
          <view class="td num">{{item.politics}}</view>
          <view class="td num">{{item.foreign}}</view>
          <view class="td num">{{item.math}}</view>
          <view class="td num">{{item.pro}}</view>
        </view>
      </view>
    </view>

    <!-- 招生情况 -->
    <view class="card box">
      <view class="box-title">招生情况<text class="box-tip">推免占比 = 推免 ÷ (统招 + 推免)</text></view>
      <view class="empty-tip" wx:if="{{!current.enroll.length}}">暂未收录招生数据，以院校官网为准</view>
      <view class="table" wx:if="{{current.enroll.length}}">
        <view class="tr th">
          <view class="td td-year">年份</view>
          <view class="td">统招计划</view>
          <view class="td">推免</view>
          <view class="td">推免占比</view>
        </view>
        <view class="tr" wx:for="{{current.enroll}}" wx:key="year">
          <view class="td td-year">{{item.year}}</view>
          <view class="td num td-strong">{{item.plan}}</view>
          <view class="td num">{{item.exempt}}</view>
          <view class="td num">{{item.exemptRate}}</view>
        </view>
      </view>
    </view>

    <!-- 招录数据：年份做列 -->
    <view class="card box">
      <view class="box-title">招录数据<text class="box-tip">复录比 = 复试人数 ÷ 录取人数</text></view>
      <view class="empty-tip" wx:if="{{!current.admit.rows.length}}">暂未收录复试 / 录取数据，以院校官网为准</view>
      <view class="table" wx:if="{{current.admit.rows.length}}">
        <view class="tr th">
          <view class="td td-label">指标</view>
          <view class="td" wx:for="{{current.admit.years}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="tr" wx:for="{{current.admit.rows}}" wx:key="label" wx:for-item="r">
          <view class="td td-label">{{r.label}}</view>
          <view class="td num {{r.strong ? 'td-strong' : ''}}" wx:for="{{r.cells}}" wx:key="year" wx:for-item="c">{{c.text}}</view>
        </view>
      </view>
      <view class="admit-tip" wx:if="{{current.admit.rows.length}}">复录比越接近 1，进入复试后被刷的比例越低</view>
    </view>

    <view class="legend">「—」表示暂未收录，以院校官网为准</view>

    <!-- 备注 -->
    <view class="card box" wx:if="{{current.notes.length || current.remark}}">
      <view class="box-title">备注</view>
      <view class="note" wx:for="{{current.notes}}" wx:key="year"><text class="note-year">{{item.year}}</text>{{item.text}}</view>
      <view class="note" wx:if="{{current.remark}}">{{current.remark}}</view>
    </view>

    <!-- 数据来源 -->
    <view class="card box" wx:if="{{current.sources.length}}">
      <view class="box-title">数据来源</view>
      <view class="source" wx:for="{{current.sources}}" wx:key="title" bindtap="copyLink" data-url="{{item.url}}">
        <view class="source-title">{{item.title}}</view>
        <view class="source-meta" wx:if="{{item.date || item.url}}">{{item.date}}{{item.url ? '　点击复制链接' : ''}}</view>
      </view>
    </view>
  </block>

  <!-- 院校评价（学校级） -->
  <view class="card box review" wx:if="{{review}}">
    <view class="box-title">院校评价<text class="box-tip" wx:if="{{review.updatedAt}}">更新于 {{review.updatedAt}}</text></view>

    <block wx:if="{{review.editor.length}}">
      <view class="rv-sub">📝 编辑点评</view>
      <view class="rv-editor">
        <view class="rv-para" wx:for="{{review.editor}}" wx:key="*this">{{item}}</view>
      </view>
    </block>

    <block wx:if="{{review.photos.length}}">
      <view class="rv-sub">📷 校园实拍<text class="rv-sub-tip">点击查看大图</text></view>
      <scroll-view scroll-x class="rv-photos" enable-flex>
        <view class="rv-photo" wx:for="{{review.photos}}" wx:key="image" bindtap="previewPhoto" data-src="{{item.src}}">
          <image class="rv-img" src="{{item.src}}" mode="aspectFill" lazy-load />
          <view class="rv-cap" wx:if="{{item.caption}}">{{item.caption}}</view>
        </view>
      </scroll-view>
    </block>

    <block wx:if="{{review.comments.length}}">
      <view class="rv-sub">💬 网友说</view>
      <view class="rv-quote" wx:for="{{review.comments}}" wx:key="text">
        <view class="rv-text">{{item.text}}</view>
        <view class="rv-meta">— {{item.author}}{{item.source ? ' · 来源：' + item.source : ''}}{{item.date ? ' · ' + item.date : ''}}</view>
      </view>
    </block>

    <view class="rv-note">以上为个人观点，仅供参考</view>
  </view>

  <view class="disclaimer">{{disclaimer}}</view>
</view>

<!-- 底部操作栏 -->
<view class="footer" wx:if="{{current}}">
  <view class="footer-cmp" bindtap="goCompare">
    <text>对比</text>
    <text class="footer-badge num" wx:if="{{compareCount}}">{{compareCount}}</text>
  </view>
  <view class="footer-btn {{inCompare ? 'on' : ''}}" bindtap="onCompare">{{inCompare ? '✓ 已加入对比（点击移出）' : '+ 加入对比'}}</view>
</view>
