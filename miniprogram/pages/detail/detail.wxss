.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ---------- 学校 ---------- */
.school {
  padding: 32rpx 32rpx 28rpx;
  background: linear-gradient(180deg, #EAF6FF 0%, #F5F9FD 100%);
}
.school-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.school-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 12rpx;
}
.school-row .tag { margin-right: 8rpx; }
.school-tag { height: 34rpx; font-size: 20rpx; background: #fff; }
.school-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.school-link {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--primary);
  word-break: break-all;
}

/* ---------- 专业切换 ---------- */
.tabs {
  white-space: nowrap;
  display: flex;
  padding: 0 24rpx 20rpx;
  box-sizing: border-box;
}
.tab {
  display: inline-block;
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid var(--line);
}
.tab.on {
  background: var(--primary-light);
  border-color: var(--primary);
}
.tab-label { font-size: 26rpx; font-weight: 600; color: var(--text-1); }
.tab.on .tab-label { color: var(--primary-dark); }
.tab-sub { font-size: 22rpx; color: var(--text-3); }

/* ---------- 卡片 ---------- */
.box {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
}
.box-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.box-tip {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
}

.major { display: flex; align-items: baseline; }
.major-code { font-size: 28rpx; color: var(--primary); margin-right: 12rpx; }
.major-name { font-size: 34rpx; font-weight: 700; }
.major-college { margin-top: 4rpx; font-size: 24rpx; color: var(--text-3); }
.major-tags { margin-top: 16rpx; display: flex; flex-wrap: wrap; }
.major-tags .tag { margin-bottom: 8rpx; }
.major-tags .tag { margin-right: 12rpx; }

.subjects {
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  background: var(--bg);
}
.subject {
  display: flex;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 2rpx solid var(--line);
}
.subject:last-child { border-bottom: none; }
.subject-label { width: 120rpx; flex-shrink: 0; color: var(--text-3); }
.subject-value { flex: 1; color: var(--text-1); }

/* ---------- 柱状图 ---------- */
.chart {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 340rpx;
  padding: 0 20rpx 8rpx;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.bar-delta {
  height: 32rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.bar-delta.up { color: var(--red); }
.bar-delta.down { color: var(--green); }
.bar-delta.flat { color: var(--text-3); }
.bar-value {
  font-size: 32rpx;
  color: var(--text-1);
}
.bar-value.muted { color: var(--text-3); font-weight: 400; }
.bar-track {
  flex: 1;
  width: 72rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: flex-end;
}
.bar {
  width: 100%;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: #B9DEFF;
}
.bar-last { background: linear-gradient(180deg, #5BB8FF, #3BA7FF); }
.bar-year {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

/* ---------- 表格 ---------- */
.table {
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid var(--line);
}
.tr {
  display: flex;
  border-bottom: 2rpx solid var(--line);
}
.tr:last-child { border-bottom: none; }
.th { background: var(--bg); }
.td {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-1);
}
.th .td { font-size: 22rpx; color: var(--text-3); font-weight: 400; }
.td-year { flex: 0 0 100rpx; color: var(--text-2); }
.td-strong { color: var(--primary); }

/* ---------- 备注 / 来源 ---------- */
.note {
  font-size: 26rpx;
  color: var(--text-2);
  padding: 8rpx 0;
}
.note-year {
  margin-right: 12rpx;
  color: var(--primary);
  font-weight: 600;
}
.source {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.source:last-child { border-bottom: none; }
.source-title { font-size: 26rpx; color: var(--text-1); }
.source-meta { margin-top: 4rpx; font-size: 22rpx; color: var(--primary); }

/* ---------- 底部操作栏 ---------- */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(31, 45, 61, 0.06);
}
.footer-cmp {
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  height: 84rpx;
  font-size: 28rpx;
  color: var(--text-2);
}
.footer-badge {
  margin-left: 8rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}
.footer-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--primary);
  color: #fff;
}
.footer-btn.on {
  background: var(--primary-light);
  color: var(--primary-dark);
}
