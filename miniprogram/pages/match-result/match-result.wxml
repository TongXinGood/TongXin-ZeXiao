<view wx:if="{{loading}}" class="state">匹配中…</view>
<view wx:elif="{{error}}" class="state">{{error}}</view>

<view wx:else class="page">
  <!-- 条件摘要 -->
  <view class="summary">
    <view class="summary-main">
      <view>
        <text class="summary-label">预估总分</text>
        <text class="num summary-score">{{scoreText}}</text>
      </view>
      <view class="summary-edit" bindtap="onEdit">修改条件</view>
    </view>
    <view class="summary-cond">{{condText}}</view>
  </view>

  <!-- 冲 / 稳 / 保 -->
  <view class="tiers">
    <view wx:for="{{tiers}}" wx:key="key" class="tier tier-{{item.key}} {{active === item.key ? 'on' : ''}}"
      bindtap="onTier" data-key="{{item.key}}">
      <view class="tier-label">{{item.label}}</view>
      <view class="tier-count"><text class="num">{{item.count}}</text> 个</view>
    </view>
  </view>
  <block wx:for="{{tiers}}" wx:key="key">
    <view class="tier-desc" wx:if="{{active === item.key}}">{{item.desc}}</view>
  </block>

  <program-card
    wx:for="{{list}}"
    wx:key="id"
    item="{{item}}"
    note="{{item.note}}"
    note-class="{{item.noteClass}}"
    warn="{{item.warn}}"
    in-compare="{{compareMap[item.id]}}"
    bind:open="onOpen"
    bind:compare="onCompare"
  />
  <view wx:if="{{!list.length}}" class="state">
    <view>这一档没有匹配的专业</view>
    <view class="empty-tip">可以试试放宽地区、学位类型或数学的限制</view>
  </view>

  <view class="extra">
    <view wx:if="{{tooHard}}">· 另有 {{tooHard}} 个专业最高分也达不到复试线，未列入</view>
    <view>· 橙色「⚠」表示该科最低分低于这个专业的单科线，需要注意</view>
    <view wx:if="{{noLine}}">· {{noLine}} 个专业缺少复试线数据，未参与匹配</view>
    <view>· 分档依据最近一年复试线，复试线每年会变化；进复试后还要看复试成绩和名额</view>
  </view>
  <view class="disclaimer">数据仅供参考，以研招网和院校官网为准</view>
</view>
