.page {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* ---------- 步骤条 ---------- */
.stepper {
  position: relative;
  display: flex;
  justify-content: space-between;
  padding: 28rpx 56rpx 32rpx;
  background: linear-gradient(180deg, #EAF6FF 0%, #F5F9FD 100%);
}
.st {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}
.st-dot {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  background: #fff;
  color: var(--text-3);
  border: 3rpx solid #DCE3EA;
  box-sizing: border-box;
}
.st.cur .st-dot { background: var(--primary); color: #fff; border-color: var(--primary); box-shadow: 0 4rpx 12rpx rgba(59, 167, 255, 0.35); }
.st.done .st-dot { background: var(--primary-light); color: var(--primary); border-color: var(--primary); }
.st-label { margin-top: 10rpx; font-size: 24rpx; color: var(--text-3); }
.st.cur .st-label { color: var(--text-1); font-weight: 700; }
.st.done .st-label { color: var(--primary); }
.st-line {
  position: absolute;
  left: 136rpx;
  right: 136rpx;
  top: 52rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #DCE3EA;
}
.st-line-in {
  height: 100%;
  border-radius: 4rpx;
  background: var(--primary);
  transition: width 0.25s;
}

/* ---------- 题目卡片 ---------- */
.q {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
}
.q-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.q-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.q-head .q-title { margin-bottom: 0; }
.q-title-gap { margin-top: 32rpx; }
.q-hint {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
}
.q-total { font-size: 24rpx; color: var(--text-2); }
.q-total .num { font-size: 34rpx; color: var(--primary); }
.q-tip {
  margin: 10rpx 0 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}
.q-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--red);
}

/* 成绩输入 */
.score-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.score-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-1);
}
.score-max { font-size: 20rpx; color: var(--text-3); margin-left: 4rpx; }
.score-in {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  background: var(--bg);
  text-align: center;
  font-size: 32rpx;
  color: var(--primary-dark);
}
.ph { color: #C4CDD6; font-size: 26rpx; font-weight: 400; }
.score-sep { margin: 0 16rpx; color: var(--text-3); }

/* 选项 */
.opts { display: flex; flex-wrap: wrap; }
.opt {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 28rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.opt-sm { min-width: 0; height: 64rpx; font-size: 26rpx; }
.opt.on {
  background: var(--primary-light);
  color: var(--primary-dark);
  border-color: var(--primary);
  font-weight: 600;
}

.sub {
  margin-top: 12rpx;
  padding: 20rpx 0 4rpx 20rpx;
  border-left: 4rpx solid var(--primary-light);
}
.sub-title {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-dark);
}

/* 说明折叠 */
.tips {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--primary-light);
  font-size: 26rpx;
  color: var(--primary-dark);
}
.tips-head { display: flex; justify-content: space-between; font-weight: 600; }
.tips-arrow { font-weight: 400; font-size: 24rpx; }
.tips-body { margin-top: 12rpx; font-size: 24rpx; line-height: 1.7; color: var(--text-2); }

.reset {
  text-align: center;
  padding: 16rpx 0 32rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------- 底部 ---------- */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 10;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(31, 45, 61, 0.06);
}
.footer-info {
  margin-bottom: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
}
.footer-num { color: var(--primary); font-size: 28rpx; }
.footer-btns { display: flex; }
.btn-ghost, .btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-ghost {
  width: 220rpx;
  margin-right: 20rpx;
  background: var(--bg);
  color: var(--text-2);
}
.btn-primary {
  flex: 1;
  background: var(--primary);
  color: #fff;
}
