.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 24rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #EAF6FF 0%, #F5F9FD 100%);
}
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }

.q {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
}
.q-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.q-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
}
.q-req {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: var(--orange-light);
  color: var(--orange);
  font-size: 20rpx;
  font-weight: 400;
}
.q-tip-inline {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
}
.q-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.score {
  display: flex;
  align-items: baseline;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  background: var(--bg);
}
.score-input {
  flex: 1;
  height: 96rpx;
  font-size: 56rpx;
  color: var(--primary);
}
.score-ph { color: #C4CDD6; font-size: 36rpx; font-weight: 400; }
.score-unit { font-size: 28rpx; color: var(--text-2); }

.opts { display: flex; flex-wrap: wrap; }
.opt {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 68rpx;
  padding: 0 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.opt.on {
  background: var(--primary-light);
  color: var(--primary-dark);
  border-color: var(--primary);
  font-weight: 600;
}

.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(31, 45, 61, 0.06);
}
.submit {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--primary);
  color: #fff;
}
.submit.disabled { background: #B9DEFF; }
